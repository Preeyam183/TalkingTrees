{
  "name": "treequest",
  "private": true,
  "version": "0.1.0",
  "main": "apps/mobile/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "tiger:setup": "node scripts/tiger-setup.mjs",
    "dev": "npm run dev -w @treequest/web",
    "build": "npm run build -w @treequest/web",
    "mobile": "expo start apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:test": "supabase test db",
    "demo:setup": "node scripts/demo-setup.mjs",
    "connected:setup": "node scripts/connected-setup.mjs",
    "presentation:refresh": "supabase db query --linked --project-ref onicsujkioycxtfztfyq --file scripts/presentation-trees.sql",
    "demo:reset": "supabase db reset && node scripts/demo-setup.mjs",
    "backend": "supabase functions serve api --env-file supabase/.env.local --no-verify-jwt",
    "test:integration": "INTEGRATION=1 vitest run tests/backend.integration.test.ts",
    "test:e2e": "playwright test",
    "presentation:leaderboard": "node scripts/presentation-leaderboard.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.1.0",
    "supabase": "^2.50.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
