APP_MODE=connected
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_WARM=
ELEVENLABS_VOICE_ID_WATCHFUL=
ELEVENLABS_VOICE_ID_QUIET=
ELEVENLABS_VOICE_ID_SOLEMN=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# Runtime PostgreSQL URI with SELECT/INSERT on sensor_history; leave empty until configured.
TIGER_DATABASE_URL=
# auto: simulated history only in demo; tiger: real Tiger even with demo controls.
HISTORY_MODE=auto
# direct (Edge PostgreSQL client) or fdw (backend-only PostgreSQL transport).
TIGER_TRANSPORT=direct
# connected:setup generates and synchronizes this privately with Vault when empty.
WORKER_SECRET=
# Optional overrides for client setup; only a public/anon key belongs here.
CLIENT_SUPABASE_URL=
CLIENT_SUPABASE_PUBLISHABLE_KEY=
